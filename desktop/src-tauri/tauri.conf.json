{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ham Study",
  "version": "0.2.6",
  "identifier": "ca.hamstudy.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Ham Study", "width": 1280, "height": 850, "minWidth": 360, "minHeight": 500, "zoomHotkeysEnabled": true }],
    "security": {
      "csp": null,
      "capabilities": [{ "identifier": "main-window", "windows": ["main"], "permissions": ["core:default", "core:webview:allow-set-webview-zoom"] }]
    }
  },
  "bundle": { "active": true, "targets": ["appimage"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
